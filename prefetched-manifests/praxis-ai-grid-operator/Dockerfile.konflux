# Konflux build for the AI Grid operator (RHOAI onboarding, RHOAIENG-95092).
# The single UBI build file for both ODH and RHOAI Konflux. FROM images pinned to
# @sha256 inline, which is the only form renovate's dockerfile manager tracks.
FROM registry.access.redhat.com/ubi9/ubi:9.8@sha256:16e9e43d99e181463513cc84a514859b1abb9460f1c4d9e208da4b4e51cd5cc3 AS build

# rust/cargo come as RPMs because rustup cannot be prefetched under hermetic mode.
# The prefetched repo exists only there, so a build without it uses the system repos.
RUN REPOS=/cachi2/output/deps/rpm/$(uname -m)/repos.d; \
    [ -d "$REPOS" ] && SETOPT="--setopt=reposdir=$REPOS" || SETOPT=""; \
    dnf install -y --nodocs --setopt=install_weak_deps=0 $SETOPT \
        gcc gcc-c++ make cmake rust cargo \
    && dnf clean all

WORKDIR /src
COPY . .
# --locked: under prefetch a build free to re-resolve can drift from what was fetched.
# --ignore-rust-version: UBI ships 1.92, the manifests declare 1.96.
RUN cargo build --release --locked --ignore-rust-version -p operator --bin operator \
    && cp target/release/operator /usr/local/bin/operator

FROM registry.redhat.io/ubi9/ubi-minimal-pqc@sha256:b3a0b012de0c578082e1bc5b01c8bc27461b4eeb571a0b1a2b21a07dbd845a62

COPY --from=build --chmod=0555 /usr/local/bin/operator /usr/local/bin/operator

USER 65532:65532
EXPOSE 9090/tcp
EXPOSE 7946/udp
ENTRYPOINT ["/usr/local/bin/operator"]

LABEL com.redhat.component="odh-praxis-ai-grid-operator-container" \
      name="odh-praxis-ai-grid-operator-rhel9" \
      description="Kubernetes operator for AI Grid multi-site inference routing" \
      summary="Kubernetes operator for AI Grid multi-site inference routing" \
      io.k8s.display-name="odh-praxis-ai-grid-operator" \
      io.k8s.description="odh-praxis-ai-grid-operator"
