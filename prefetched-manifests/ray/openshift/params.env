namespace=opendatahub
# These defaults match the vendored KubeRay manifests for standalone Kustomize
# deployments. ODH/RHOAI release tooling may override them at deploy time.
odh-ray-module-operator-image=quay.io/opendatahub/odh-ray-module-operator:latest
odh-kuberay-operator-controller-image=quay.io/opendatahub/kuberay-operator:v1.6.2
odh-kube-rbac-proxy-image=quay.io/opendatahub/odh-kube-rbac-proxy:odh-stable
